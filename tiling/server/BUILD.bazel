load("@aspect_bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")
load("@aspect_rules_py//py:defs.bzl", "py_binary")
load("@aspect_rules_py//py:defs.bzl", "py_image_layer")
load("@rules_oci//oci:defs.bzl", "oci_image", "oci_load")

py_binary(
    name = "server",
    srcs = glob(["src/**/*.py"]),
    main = "src/tile_server.py",
    deps = [
    ],
)

py_image_layer(
    name = "server.layers",
    binary = ":server",
)

oci_image(
    name = "server.image",
    base = "//tools/docker:base_oci_image",
    entrypoint = ["/tiling/server/server"],
    tars = [
        ":server.layers",
    ],
)

platform(
    name = "aarch64_linux",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

platform(
    name = "x86_64_linux",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

platform_transition_filegroup(
    name = "platform_image",
    srcs = [":server.image"],
    target_platform = select({
        "@platforms//cpu:arm64": ":aarch64_linux",
        "@platforms//cpu:x86_64": ":x86_64_linux",
    }),
)

oci_load(
    name = "server.load",
    image = ":platform_image",
    repo_tags = ["tiling-server:latest"],
)
